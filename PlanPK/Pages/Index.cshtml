@page
@model IndexModel
@{
    ViewData["Title"] = "План приемной кампании 2026";
}

@functions {
    void RenderIssueTree(IEnumerable<Issues> issues)
    {
        <ul class="issue-tree">
            @foreach (var issue in issues)
            {
                <li>
                    <div class="issue-card">
                        <div class="issue-title">
                            <span class="issue-number">@issue.Number</span>
                            <span class="issue-name">@issue.Name</span>
                        </div>
                        <dl class="issue-meta">
                            <div>
                                <dt>ID</dt>
                                <dd>@issue.Id</dd>
                            </div>
                            <div>
                                <dt>Parent ID</dt>
                                <dd>@(issue.ParentId ?? "—")</dd>
                            </div>
                            <div>
                                <dt>План, ч</dt>
                                <dd>@issue.PlanHours</dd>
                            </div>
                            <div>
                                <dt>Факт, ч</dt>
                                <dd>@issue.FaktHours</dd>
                            </div>
                            <div>
                                <dt>Срок</dt>
                                <dd>@(issue.TermDate?.ToString("dd.MM.yyyy") ?? "—")</dd>
                            </div>
                        </dl>
                    </div>

                    @if (issue.ChildrenIssue?.Any() ?? false)
                    {
                        RenderIssueTree(issue.ChildrenIssue);
                    }
                </li>
            }
        </ul>
    }
}

<div class="tree-wrapper">
    @if (Model.Issues.Any())
    {
        RenderIssueTree(Model.Issues);
    }
    else
    {
        <div class="empty-state">Данные отсутствуют</div>
    }
</div>
