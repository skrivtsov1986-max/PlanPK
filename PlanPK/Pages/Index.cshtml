@page
@model IndexModel
@{
    ViewData["Title"] = "План приемной кампании 2026";
}

@functions {
    void RenderIssueRows(IEnumerable<Issues> issues, int level)
    {
        foreach (var issue in issues)
        {
            <tr>
                <td>@issue.Number</td>
                <td>
                    <div class="tree-cell" style="padding-left:@(level * 16)px">
                        <span class="tree-branch">@((issue.ChildrenIssue?.Any() ?? false) ? "▸" : "•")</span>
                        <span>@issue.Name</span>
                    </div>
                </td>
            </tr>

            if (issue.ChildrenIssue?.Any() ?? false)
            {
                RenderIssueRows(issue.ChildrenIssue, level + 1);
            }
        }
    }
}

<div class="table-wrapper">
    <table class="my-table">
        <thead>
            <tr>
                <th>Номер задачи</th>
                <th>Наименование задачи</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Issues.Any())
            {
                RenderIssueRows(Model.Issues, 0);
            }
            else
            {
                <tr>
                    <td colspan="2" class="text-center">Данные отсутствуют</td>
                </tr>
            }
        </tbody>
    </table>
</div>
